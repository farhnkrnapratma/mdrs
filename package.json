{
  "name": "@mdrs/core",
  "version": "1.0.0-alpha3",
  "description": "Renderer for MDRS (Markdown Rich Syntax), a superset of Markdown with callouts, tabs, math, diagrams and variables. Native addon for Node.js and Bun, WebAssembly for browsers.",
  "license": "MIT OR Apache-2.0",
  "author": "Farhan Kurnia Pratama <farhnkrnapratma@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/farhnkrnapratma/mdrs.git"
  },
  "homepage": "https://github.com/farhnkrnapratma/mdrs#readme",
  "bugs": {
    "url": "https://github.com/farhnkrnapratma/mdrs/issues"
  },
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "browser": "./browser.js",
      "default": "./index.js"
    },
    "./lazy": {
      "types": "./lazy.d.ts",
      "default": "./lazy.js"
    },
    "./wasm": "./wasm/mdrs_bg.wasm",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.native.js",
    "index.d.ts",
    "index.native.d.ts",
    "path.js",
    "browser.js",
    "lazy.js",
    "lazy.d.ts",
    "wasm/mdrs.js",
    "wasm/mdrs.d.ts",
    "wasm/mdrs_bg.wasm",
    "wasm/mdrs_bg.wasm.d.ts",
    "wasm/package.json",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "keywords": [
    "markdown",
    "commonmark",
    "gfm",
    "parser",
    "directives",
    "mdrs"
  ],
  "sideEffects": false,
  "scripts": {
    "prepare": "bash .githooks/install.sh",
    "build": "napi build --platform --features napi --esm --js index.native.js --dts index.native.d.ts",
    "build:release": "napi build --platform --release --features napi --esm --js index.native.js --dts index.native.d.ts",
    "build:wasm": "node scripts/build-wasm.mjs",
    "test:bindings": "bun scripts/test-bindings.mjs",
    "test:native": "bun run build:release && bun run test:bindings",
    "test:wasm": "node scripts/test-wasm.mjs"
  },
  "napi": {
    "binaryName": "mdrs",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl",
      "armv7-unknown-linux-gnueabihf",
      "powerpc64le-unknown-linux-gnu",
      "s390x-unknown-linux-gnu",
      "riscv64gc-unknown-linux-gnu",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc",
      "i686-pc-windows-msvc"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@napi-rs/cli": "^3.11.1",
    "fallow": "^3.48.0"
  }
}
